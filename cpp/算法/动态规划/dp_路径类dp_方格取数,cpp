#include<bits/stdc++.h>
using namespace std;
typedef long long ll;

const int N=12;
int a[N][N];
int dp[N][N][N][N];
int n;

int main()
{
    cin>>n;

    memset(a,0,sizeof a);
    int x,y,num;
    while(cin>>x>>y>>num,x||y||num) a[x][y]=num;

    for(int x1=1;x1<=n;x1++)
    {
        for(int y1=1;y1<=n;y1++)
        {
            for(int x2=1;x2<=n;x2++)
            {
                for(int y2=1;y2<=n;y2++)
                {
                    int gain=a[x1][y1];
                    if(!(x1==x2&&y1==y2)) gain+=a[x2][y2];

                    int &val = dp[x1][y1][x2][y2];
                    val=max(val,dp[x1-1][y1][x2-1][y2]+gain);
                    val=max(val,dp[x1-1][y1][x2][y2-1]+gain);
                    val=max(val,dp[x1][y1-1][x2-1][y2]+gain);
                    val=max(val,dp[x1][y1-1][x2][y2-1]+gain);
                }
            }
        }
    }

    cout<<dp[n][n][n][n]<<endl;

    return 0;
}