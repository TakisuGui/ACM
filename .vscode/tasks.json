{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "D:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-Wl,--stack,16777216"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "调试器生成的任务。"
        },
        {
            "label": "Java: 编译并运行",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "cd '${fileDirname}'; javac '${fileName}' -encoding utf-8; if ($LASTEXITCODE -eq 0) { $package = (Get-Content '${fileName}' | Select-String '^package\\s+([^;]+);').Matches.Groups[1].Value; if ($package) { cd ..; java \"$package.${fileBasenameNoExtension}\" } else { java '${fileBasenameNoExtension}' } }"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}